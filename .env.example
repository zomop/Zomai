# ===== DISCORD BOT =====
# Ambil dari https://discord.com/developers/applications
# Bot > Token > Reset Token (copy token bot)
DISCORD_TOKEN=isi_token_bot_disini

# General Information > Application ID (copy ini)
CLIENT_ID=isi_application_id_disini

# Opsional: isi GUILD_ID untuk deploy command cepat ke 1 server (dev)
# Kalau kosong, command akan didaftarkan global (butuh ~1 jam muncul)
GUILD_ID=

# ===== GITHUB WEBHOOK / SYNC =====
# Buat secret random, isi sama persis di GitHub Repo > Settings > Webhooks > Secret
GITHUB_WEBHOOK_SECRET=isi_secret_random_disini

# OPSIONAL: channel default untuk notifikasi GitHub (kalau mau 1 channel tetap)
# Kalau kosong, tiap server atur channel sendiri via command /setup-github #channel
# Cara dapat Channel ID: aktifkan Developer Mode di Discord Settings > Advanced,
# lalu klik kanan channel > Copy Channel ID
GITHUB_CHANNEL_ID=

# Opsional: batasi hanya repo tertentu, format: owner/repo
# Kosong = terima semua repo yang webhook-nya dipasang
GITHUB_REPO_FILTER=

# Port untuk webhook server (default 3000)
PORT=3000

# ===== LAINNYA =====
# ID role / user owner bot (opsional, untuk command owner-only)
OWNER_ID=

# Warna embed default (hex tanpa #)
EMBED_COLOR=5865F2
